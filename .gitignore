!/data/README.md
!/data/source_metadata.json
!/docs/
/docs/*
!/docs/meeting_20261021/
/docs/meeting_20261021/*
!/docs/meeting_20261021/01_design.png
!/docs/meeting_20261021/02_price_information.png
!/docs/meeting_20261021/03_behavior_increment.png
!/docs/meeting_20261021/04_stage_check.png
